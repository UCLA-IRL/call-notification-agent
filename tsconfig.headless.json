{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": [
    "src/node/**/*",
    "src/services/database/**/*",
    "src/services/workspace.ts",
    "src/services/workspace-chat.ts",
    "src/services/workspace-proj.ts",
    "src/services/workspace-agent.ts",
    "src/services/workspace-invite.ts",
    "src/services/svs-provider.ts",
    "src/services/ndn.ts",
    "src/services/event-bus.ts",
    "src/services/types.ts",
    "src/services/database/stats.ts",
    "src/services/database/proj_db.ts",
    "src/services.d.ts",
    "src/utils/bundler.ts",
    "src/utils/extensions.ts",
    "src/utils/files.ts",
    "src/utils/index.ts",
    "src/utils/theme.ts",
    "src/utils/url.ts"
  ],
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
