{
  "name": "ownly",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx --tsconfig tsconfig.headless.json src/node/headless_dns.ts",
    "go:wasm": "cd ndn/cmd && cross-env GOOS=js GOARCH=wasm go build -ldflags \"-s -w\" -o ../../public/main.wasm main.go",
    "go:js": "cp $(go env GOROOT)/misc/wasm/wasm_exec.js ./public/wasm_exec.js"
  },
  "dependencies": {
    "@wcj/markdown-to-html": "^3.0.5",
    "cors": "^2.8.5",
    "dexie": "^4.0.11",
    "dotenv": "^17.3.1",
    "events": "^3.3.0",
    "express": "^4.21.2",
    "nanoid": "^5.1.3",
    "nodemailer": "^7.0.9",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.24"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.0",
    "@types/cors": "^2.8.17",
    "@types/events": "^3.0.3",
    "@types/express": "^4.17.21",
    "@types/golang-wasm-exec": "^1.15.2",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^6.4.17",
    "cross-env": "^7.0.3",
    "tsx": "^4.23.1",
    "typed-emitter": "^2.1.0",
    "typescript": "~5.8.2"
  }
}
